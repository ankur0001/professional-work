# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret-for-production

# Demo mode: runs without PostgreSQL or external AI keys (recommended for first run)
DEMO_MODE=true

# Database (required when DEMO_MODE=false)
DATABASE_URL=postgresql://executivespeak:executivespeak@localhost:5432/executivespeak

# AI providers (optional — mock used when unset)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech (optional — browser Web Speech API + mock fallback)
SPEECH_TO_TEXT_PROVIDER=browser
TEXT_TO_SPEECH_PROVIDER=browser

# Pronunciation analysis (optional)
PRONUNCIATION_PROVIDER=mock
